local function Alert(Message, Color)
    NotifyText.Text = Message
    Notify.BackgroundColor3 = Color or Color3.fromRGB(40, 180, 100)
    Notify.Visible = true
    TweenService:Create(Notify, TweenInfo.new(0.25), {Position = UDim2.new(0.5, -150, 0.05, 0)}):Play()
    task.wait(1.8)
    TweenService:Create(Notify, TweenInfo.new(0.25), {Position = UDim2.new(0.5, -150, -0.1)}):Play()
    task.wait(0.2)
    Notify.Visible = false
end

-- ===== ตรวจจับตัวละคร =====
local function SetupChar()
    LocalPlayer.CharacterAdded:Connect(function(c)
        Character = c
        Humanoid = c:WaitForChild("Humanoid")
    end)
    if LocalPlayer.Character then
        Character = LocalPlayer.Character
        Humanoid = Character:WaitForChild("Humanoid")
    end
end
SetupChar()

-- ===== ปรับค่าต่างๆ =====
local function ApplyAll()
    if not Humanoid then return end
    local Speed = math.clamp(tonumber(InputSpeed.Text) or Settings.BaseSpeed, 1, 100)
    local Jump = math.clamp(tonumber(InputJump.Text) or Settings.BaseJump, 1, 100)
    Humanoid.WalkSpeed = Speed
    Humanoid.JumpPower = Jump
    Humanoid.JumpHeight = Jump / 2
    InputSpeed.Text = tostring(Speed)
    InputJump.Text = tostring(Jump)
    Alert("✅ ตั้งค่าเร็ว:"..Speed.." กระโดด:"..Jump, Color3.fromRGB(80,255,120))
end

-- ===== ระบบย่อขยาย 2 ขั้น =====
local function UpdateMinimize()
    if Settings.MinimizeStage == 0 then
        Main.Size = UDim2.new(0,340,0,600)
        Main.Visible = true
        Content.Visible = true
        BtnMin1.Text = "−"
        BtnMin2.Text = "●"
        CircleBtn.Visible = false
    elseif Settings.MinimizeStage == 1 then
        Main.Size = UDim2.new(0,340,0,50)
        Content.Visible = false
        BtnMin1.Text = "+"
        BtnMin2.Text = "●"
        CircleBtn.Visible = false
    else
        Main.Visible = false
        CircleBtn.Visible = true
    end
end

BtnMin1.MouseButton1Click:Connect(function()
    if Settings.MinimizeStage < 2 then
        Settings.MinimizeStage = Settings.MinimizeStage + 1
        UpdateMinimize()
    end
end)

BtnMin2.MouseButton1Click:Connect(function()
    Settings.MinimizeStage = 2
    UpdateMinimize()
end)

CircleBtn.MouseButton1Click:Connect(function()
    Settings.MinimizeStage = 0
    UpdateMinimize()
end)

-- ===== ปุ่มอื่นๆ =====
BtnApply.MouseButton1Click:Connect(ApplyAll)

BtnCopy.MouseButton1Click:Connect(function()
    if InputScript.Text == "" then Alert("❌ ไม่มีสคริปต์",Color3.fromRGB(255,80,80)) return end
    setclipboard(InputScript.Text)
    Alert("✅ คัดลอกแล้ว",Color3.fromRGB(70,130,180))
end)

BtnRun.MouseButton1Click:Connect(function()
